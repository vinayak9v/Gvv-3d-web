generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
}
model AdmissionEnquiry {
  id            Int      @id @default(autoincrement())
  studentName   String
  parentName    String
  classApplying String
  mobileNumber  String
  email         String
  message       String?
  createdAt     DateTime @default(now())

  @@map("admission_enquiries")
}

model FeeStructure {
  id               Int      @id @default(autoincrement())
  className        String

  installment1     Float
  installment2     Float
  installment3     Float

  annualAllocation Float
  totalFee         Float

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}