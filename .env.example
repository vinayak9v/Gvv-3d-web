# MySQL connection used by src/lib/db.js (raw mysql2 pool) - required for all
# DB-backed features: admission enquiries, fee structure, achievements, gallery,
# facilities, curriculum, academic calendar, book lists, downloadable forms.
# Run db/schema.sql against this database once before first use.
MYSQL_HOST="localhost"
MYSQL_USER="root"
MYSQL_PASSWORD="root"
MYSQL_DATABASE="school_db"



# --- Admin panel auth ---
# Generate with: node scripts/hash-admin-password.mjs "your-chosen-password"
# Produces a "salt:hash" string - paste the full output here, never the raw password.
ADMIN_PASSWORD_HASH="salt_hex:hash_hex"

# Any long random string, used to sign the admin session cookie.
# Generate one with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"
